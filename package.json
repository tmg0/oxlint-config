{
  "name": "@tmg0/oxlint-config",
  "version": "0.1.0",
  "description": "Tamago's oxlint + oxfmt config. An @antfu/eslint-config-style preset, powered by oxlint.",
  "license": "MIT",
  "author": "tmg0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.mts",
      "default": "./dist/oxfmt.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "eslint-plugin-perfectionist": "^5.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tsdown": "^0.18.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.0"
}
